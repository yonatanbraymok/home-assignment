# Copy to .env.local and fill in. Never commit real values.

# Database: Supabase Postgres. The app connects through the transaction pooler (port 6543);
# migrations use the session pooler (port 5432).
DATABASE_URL=
DIRECT_URL=

# Telegram: the bot's token and username from BotFather, a webhook secret
# (1-256 characters: A-Z a-z 0-9 _ -), and your own numeric Telegram id for admin notices.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_USER_ID=

# The app's public address: links in Telegram, Google's redirect, the MCP endpoint.
APP_URL=http://localhost:3000

# Secrets. Generate each with: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY encrypts Gmail tokens (32 bytes, base64); keep it if you keep the database.
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
CRON_SECRET=

# Google OAuth client (Web), Gmail API enabled, scope gmail.readonly.
# Redirect URI: <APP_URL>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini API key (a billed project, so email content isn't used for training).
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-3.5-flash-lite            # the default model
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite   # for reading emails from 80% of a budget; "none" turns it off
# LLM_MONTHLY_BUDGET_USD=25                     # the shared AI cap, evals included
# LLM_USER_MONTHLY_BUDGET_USD=5                 # each person's AI allowance
# LLM_DEBUG=1                                   # log the chat's tool rounds (names only, never content)
